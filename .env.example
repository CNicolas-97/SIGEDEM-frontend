# Variables de entorno de ejemplo. Este archivo SÍ se sube a git.
# Para usarlas: copiá este archivo como ".env" (ese NO se sube) y cambiá
# los valores si hace falta. Vite las lee al arrancar "npm run dev": si
# cambiás algo, reiniciá el servidor.
# Solo llegan al navegador las que empiezan con VITE_. No pongas acá
# contraseñas ni claves secretas: todo lo que lee el front queda a la vista.

# Dirección pública del sitio. Con ella se arman las URLs canónicas (SEO).
VITE_SITE_URL=https://sigedem-frontend.vercel.app

# Dirección del backend (NestJS). Todavía no existe: queda lista para cuando
# los formularios manden los datos con fetch.
VITE_API_URL=http://localhost:3000
